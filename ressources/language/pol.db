:"cyrus.imapd.stats.auth.title";s:16:"Uwierzytelnianie";s:31:"cyrus.imapd.stats.authoritative";s:31:"Warto&#347;&#263; autorytatywna";s:30:"cyrus.imapd.stats.auth_failure";s:8:"Nieudane";s:30:"cyrus.imapd.stats.auth_success";s:5:"Udane";s:27:"cyrus.imapd.stats.by_domain";s:26:"Wolumen wed&#322;ug domeny";s:27:"cyrus.imapd.stats.collector";s:8:"Kolektor";s:36:"cyrus.imapd.stats.collectors.explain";s:179:"Stan i harmonogram kolektor&#243;w statystyk (szybkie skanowanie, g&#322;&#281;bokie skanowanie, Prometheus, uzgadnianie, alerty, retencja). Uruchom kolektor na &#380;&#261;danie.";s:34:"cyrus.imapd.stats.collectors.title";s:9:"Kolektory";s:26:"cyrus.imapd.stats.commands";s:9:"Polecenia";s:33:"cyrus.imapd.stats.commands_failed";s:18:"Nieudane polecenia";s:29:"cyrus.imapd.stats.connections";s:20:"Po&#322;&#261;czenia";s:36:"cyrus.imapd.stats.critical_partition";s:30:"Najbardziej krytyczna partycja";s:35:"cyrus.imapd.stats.dashboard.explain";s:162:"Bie&#380;&#261;cy obraz inwentaryzacji, pami&#281;ci i limit&#243;w magazynu poczty Cyrus, ze wska&#378;nikiem jako&#347;ci danych i wiekiem ostatniego zbierania.";s:33:"cyrus.imapd.stats.dashboard.title";s:22:"Pulpit statystyk Cyrus";s:26:"cyrus.imapd.stats.data_age";s:11:"wiek danych";s:27:"cyrus.imapd.stats.deep_scan";s:29:"G&#322;&#281;bokie skanowanie";s:33:"cyrus.imapd.stats.domains.explain";s:78:"Sumy pami&#281;ci, wiadomo&#347;ci i limit&#243;w wed&#322;ug domeny lokalnej.";s:31:"cyrus.imapd.stats.domains.title";s:16:"Statystyki domen";s:23:"cyrus.imapd.stats.drift";s:22:"Odchylenie uzgadniania";s:27:"cyrus.imapd.stats.emergency";s:18:"Sytuacja krytyczna";s:25:"cyrus.imapd.stats.explain";s:107:"Statystyki wolumetryczne: sumy, wzrost pami&#281;ci, najwi&#281;ksze skrzynki i wolumen wed&#322;ug domeny.";s:37:"cyrus.imapd.stats.export.download_csv";s:16:"Eksportuj do CSV";s:38:"cyrus.imapd.stats.export.download_json";s:17:"Eksportuj do JSON";s:32:"cyrus.imapd.stats.export.explain";s:193:"Wyeksportuj bie&#380;&#261;ce st