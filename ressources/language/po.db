[blk]500:600[/blk]
lista de portas:[br]
[blk]80,21,443,9000,143,993[/blk]";s:16:"iptables_results";s:9:"Resultado";s:10:"local_port";s:11:"Porta local";s:14:"log_this_event";s:35:"Registar esta regra se corresponder";s:6:"REJECT";s:20:"Rejeitar (notificar)";s:19:"sender_user_explain";s:470:"Esta %C3¡rea foi concebida para transformar o seu endereço original num novo endereço quando as mensagens s%C3£o enviadas através da Internet[br].
