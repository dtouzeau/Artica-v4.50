Um hostname:[br]
[blk]proxy.p19.ovh.net[/blk]";s:14:"insert_default";s:19:"Regras predefinidas";s:19:"insert_default_text";s:65:"Adicionar regras predefinidas para proteger o seu servidor Artica";s:12:"iptablesconf";s:30:"Mostrar configura&#231;&#227;o";s:16:"iptablescurrules";s:23:"Estado atual das regras";s:13:"iptables_from";s:2:"De";s:16:"iptables_frommac";s:23:"Ou de endere&#231;o MAC";s:14:"iptables_INPUT";s:7:"Entrada";s:12:"iptables_nic";s:3:"NIC";s:14:"iptables_ports";s:159:"Deveria ser:[br]
Uma &#250;nica porta: [br]
[blk]80[/blk]
