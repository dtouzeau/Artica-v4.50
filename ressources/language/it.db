;s:18:"new_network_bridge";s:20:"Nuovo bridge di rete";s:11:"new_netzone";s:18:"Nuova zona di rete";s:14:"new_net_bridge";s:20:"Nuovo bridge di rete";s:7:"new_nic";s:17:"Nuova interfaccia";s:8:"new_node";s:10:"Nuovo nodo";s:10:"new_object";s:13:"Nuovo oggetto";s:10:"new_option";s:13:"Nuova opzione";s:8:"new_page";s:12:"Nuova pagina";s:8:"new_path";s:14:"Nuovo percorso";s:13:"new_php_value";s:16:"Nuovo valore PHP";s:10:"new_policy";s:14:"Nuova politica";s:8:"new_port";s:11:"Nuovo porto";s:13:"new_privilege";s:16:"Nuovo privilegio";s:11:"new_profile";s:13:"Nuovo profilo";s:12:"new_provider";s:14:"Nuovo provider";s:9:"new_proxy";s:11:"Nuovo proxy";s:15:"new_proxy_alias";s:21:"Nuovo alias del proxy";s:16:"new_proxy_object";s:19:"Nuovo oggetto proxy";s:9:"new_query";s:11:"Nuova query";s:16:"new_quota_object";s:19:"Nuovo oggetto quota";s:17:"new_radius_client";s:19:"Nuovo client radius";s:9:"new_range";s:16:"Nuovo intervallo";s:10:"new_record";s:12:"Nuovo record";s:11:"NEW_RELEASE";s:13:"Nuova release";s:16:"NEW_RELEASE_TEXT";s:222:"%C3%88 disponibile una nuova release di Artica, è possibile aggiornare il proprio server a questa nuova versione.[br]
